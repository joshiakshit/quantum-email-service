# ─────────────────────────────────────────────────────────────────────────────
# QuMail Key Manager — Environment Configuration
# Copy this file to .env and fill in real values before running.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default — suitable for MVP/development)
DATABASE_URL=sqlite+aiosqlite:///./qumail_keys.db

# PostgreSQL (for production — uncomment and fill in):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/qumail_keys

# ── JWT ───────────────────────────────────────────────────────────────────────
# REQUIRED: Replace with a strong random secret before deployment.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_SECRETS_TOKEN_HEX_32

# JWT algorithm — do not change unless you know what you are doing
JWT_ALGORITHM=HS256

# Token lifetime in minutes (default: 60)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Session Keys (Simulated QKD) ──────────────────────────────────────────────
# How long simulated QKD session keys remain valid (hours, default: 24)
SESSION_KEY_EXPIRY_HOURS=24

# Key material length in bytes — 32 = 256-bit key (recommended)
SESSION_KEY_LENGTH_BYTES=32

# ── Application ──────────────────────────────────────────────────────────────
# Set to true to enable SQLAlchemy query logging (development only)
DEBUG=false
