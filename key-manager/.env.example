# QMail Key Manager — Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env to version control.

# Database (SQLite default, switch to PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./qmail_keys.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/qmail_keys

# JWT — REQUIRED: replace with a strong random secret
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_SECRETS_TOKEN_HEX_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Session Keys (BB84-simulated QKD)
SESSION_KEY_EXPIRY_HOURS=24
SESSION_KEY_LENGTH_BYTES=32

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:9000

# HTTPS — redirect HTTP to HTTPS and add HSTS header
ENFORCE_HTTPS=false

# Debug mode (enables SQL echo + OpenAPI docs)
DEBUG=false
