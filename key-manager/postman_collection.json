{
  "info": {
    "name": "QuMail Key Manager API",
    "description": "Complete API collection for the QuMail Key Manager (M2).\n\nWorkflow:\n1. Register Alice → save client_id + registration_secret\n2. Get Token for Alice\n3. Register Bob → save client_id + registration_secret\n4. Get Token for Bob\n5. Alice gets Bob's public keys\n6. Alice requests session-key material\n7. Bob retrieves the same session key",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000", "type": "string" },
    { "key": "alice_client_id", "value": "", "type": "string" },
    { "key": "alice_secret", "value": "", "type": "string" },
    { "key": "alice_token", "value": "", "type": "string" },
    { "key": "bob_client_id", "value": "", "type": "string" },
    { "key": "bob_secret", "value": "", "type": "string" },
    { "key": "bob_token", "value": "", "type": "string" },
    { "key": "session_key_id", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"status\": \"ok\",\n  \"service\": \"QuMail Key Manager\",\n  \"version\": \"1.0.0\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Clients",
      "item": [
        {
          "name": "Register Alice",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "pm.collectionVariables.set('alice_client_id', data.client_id);",
                  "pm.collectionVariables.set('alice_secret', data.registration_secret);",
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('client_id starts with QM-', () => pm.expect(data.client_id).to.match(/^QM-/));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice\",\n  \"ml_kem_public_key\": \"dGVzdC1tbC1rZW0tcHVibGljLWtleS1hbGljZQ==\",\n  \"ml_dsa_public_key\": \"dGVzdC1tbC1kc2EtcHVibGljLWtleS1hbGljZQ==\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/clients/register", "host": ["{{base_url}}"], "path": ["api", "v1", "clients", "register"] }
          }
        },
        {
          "name": "Register Bob",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "pm.collectionVariables.set('bob_client_id', data.client_id);",
                  "pm.collectionVariables.set('bob_secret', data.registration_secret);",
                  "pm.test('Status 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bob\",\n  \"ml_kem_public_key\": \"dGVzdC1tbC1rZW0tcHVibGljLWtleS1ib2I=\",\n  \"ml_dsa_public_key\": \"dGVzdC1tbC1kc2EtcHVibGljLWtleS1ib2I=\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/clients/register", "host": ["{{base_url}}"], "path": ["api", "v1", "clients", "register"] }
          }
        },
        {
          "name": "Get Client Info (Alice)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{alice_token}}" }],
            "url": { "raw": "{{base_url}}/api/v1/clients/{{alice_client_id}}", "host": ["{{base_url}}"], "path": ["api", "v1", "clients", "{{alice_client_id}}"] }
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Get Token (Alice)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "pm.collectionVariables.set('alice_token', data.access_token);",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('token_type is bearer', () => pm.expect(data.token_type).to.eql('bearer'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_id\": \"{{alice_client_id}}\",\n  \"registration_secret\": \"{{alice_secret}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/auth/token", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "token"] }
          }
        },
        {
          "name": "Get Token (Bob)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "pm.collectionVariables.set('bob_token', data.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_id\": \"{{bob_client_id}}\",\n  \"registration_secret\": \"{{bob_secret}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/auth/token", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "token"] }
          }
        }
      ]
    },
    {
      "name": "Keys",
      "item": [
        {
          "name": "Get Bob's Public Keys (as Alice)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{alice_token}}" }],
            "url": { "raw": "{{base_url}}/api/v1/keys/public/{{bob_client_id}}", "host": ["{{base_url}}"], "path": ["api", "v1", "keys", "public", "{{bob_client_id}}"] }
          }
        },
        {
          "name": "Request Session Key Material (Alice → Bob)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "pm.collectionVariables.set('session_key_id', data.key_id);",
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('algorithm is SIMULATED-QKD', () => pm.expect(data.algorithm).to.eql('SIMULATED-QKD'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{alice_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sender_id\": \"{{alice_client_id}}\",\n  \"recipient_id\": \"{{bob_client_id}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/keys/request", "host": ["{{base_url}}"], "path": ["api", "v1", "keys", "request"] }
          }
        },
        {
          "name": "Retrieve Session Key (as Bob)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{bob_token}}" }],
            "url": { "raw": "{{base_url}}/api/v1/keys/{{session_key_id}}", "host": ["{{base_url}}"], "path": ["api", "v1", "keys", "{{session_key_id}}"] }
          }
        }
      ]
    }
  ]
}
